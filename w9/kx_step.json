"(() => { const S = new URL(location.href).searchParams.get('series_ticker'); let d; try { d = JSON.parse(document.body.innerText) } catch (e) { return 'NOJSON ' + location.href.slice(-60) }\nconst ms = d.markets || []; const rows = ms.filter(m => /-26(NOV05|NOV06|NOV08|NOV09|NOV10)/.test(m.event_ticker)).map(m => [m.event_ticker, m.ticker, m.yes_sub_title, m.floor_strike, m.yes_ask_dollars, m.yes_bid_dollars, m.no_ask_dollars, m.last_price_dollars, m.volume_fp, m.status]);\nconst st = JSON.parse(localStorage.getItem('kx09') || '{}'); st[location.href] = [S, rows]; localStorage.setItem('kx09', JSON.stringify(st));\nreturn JSON.stringify({S, n: ms.length, kept: rows.length, cursor: ms.length ? (d.cursor || '') : ''}) })()"